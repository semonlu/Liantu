{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node scripts/build-knowledge-index.mjs",
    "knowledge:build": "node scripts/build-knowledge-index.mjs",
    "model:validate": "node --experimental-strip-types scripts/validate-model-providers.ts",
    "mobile:build": "node scripts/build-knowledge-index.mjs && vite build --config vite.mobile.config.ts",
    "android:sync": "npm run mobile:build && cap sync android",
    "android:debug": "npm run android:sync && android\\gradlew.bat assembleDebug",
    "android:release": "npm run android:sync && android\\gradlew.bat assembleRelease",
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
